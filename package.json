{
  "name": "pi-inline-tags",
  "version": "0.9.1",
  "description": "Inline reference tags for pi: the agent writes <pi-ref />, <pi-date />, <pi-file /> … in a tool call and the extension replaces them with real session values before the tool runs. Your own tags are fixed text, a template, your own regex, or a script file; a tag it cannot resolve refuses the call.",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "test": "node --experimental-strip-types selftest.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "coding-agent",
    "inline-tags",
    "references",
    "prompt-hook",
    "user-defined-tags",
    "tool-call-arguments"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "author": {
    "name": "voorjaar",
    "email": "felitas@zoho.com",
    "url": "https://github.com/voorjaar"
  },
  "homepage": "https://github.com/voorjaar/pi-inline-tags#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voorjaar/pi-inline-tags.git"
  },
  "bugs": {
    "url": "https://github.com/voorjaar/pi-inline-tags/issues"
  },
  "license": "MIT"
}
